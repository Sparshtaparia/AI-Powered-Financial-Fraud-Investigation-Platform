# ==========================================
# 🏢 ENTERPRISE AML PLATFORM ENV VARIABLES
# ==========================================
# Copy this file to .env and fill in the actual values.
# DO NOT commit your actual .env file to version control.

# ------------------------------------------
# 1. APPLICATION SETTINGS
# ------------------------------------------
ENVIRONMENT=development
# FastAPI settings
PORT=8000
HOST=0.0.0.0

# ------------------------------------------
# 2. POSTGRESQL (Neon / CockroachDB / Local)
# ------------------------------------------
#use a single connection string:
DATABASE_URL=

# ------------------------------------------
# 3. NEO4J (Aura / Local)
# ------------------------------------------
# Graph DB for knowledge graphs and relationships
NEO4J_URI=
NEO4J_USERNAME=
NEO4J_PASSWORD=

# ------------------------------------------
# 4. REDIS (Redis Cloud / Local)
# ------------------------------------------
# Caching, sessions, and LangGraph planner memory
REDIS_URL=redis://localhost:6379

# ------------------------------------------
# 5. LLM API KEYS (Pick one or more)
# ------------------------------------------
# For LangGraph planners, reasoning, and report generation
GOOGLE_API_KEY=

# ------------------------------------------
# 6. VECTOR DATABASE (Optional - for RAG)
# ------------------------------------------
# Local Qdrant requires no credentials, uncomment if using Cloud
QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=your_qdrant_api_key

# ================================================
# OBJECT STORAGE (MinIO)
# ================================================
STORAGE_PROVIDER=minio

S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
S3_REGION=

# ------------------------------------------
# 8. AUTHENTICATION (Supabase / Clerk)
# ------------------------------------------
# SUPABASE_URL=your_supabase_url
# SUPABASE_ANON_KEY=your_supabase_key
# CLERK_SECRET_KEY=your_clerk_secret

# ------------------------------------------
# 9. KAFKA / REDPANDA (Optional)
# ------------------------------------------
# For live transaction streaming simulations
KAFKA_BROKER=localhost:9092
# KAFKA_USERNAME=
# KAFKA_PASSWORD=

# ------------------------------------------
# 10. EXTERNAL APIs (Optional)
# ------------------------------------------
# Email notifications (Resend / SendGrid)
# RESEND_API_KEY=
# Maps (Google Maps / Mapbox)
# MAPBOX_API_KEY=

# ------------------------------------------
# 11. MLFLOW (Optional)
# ------------------------------------------
# Model tracking (Local or Remote)
MLFLOW_TRACKING_URI=http://localhost:5000
